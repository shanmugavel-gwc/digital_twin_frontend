# Environment for the Render web service "digital-twin-frontend" (server.mjs).
# Render -> digital-twin-frontend -> Environment -> "Add from .env" -> paste the lines below, fill in the
# <placeholders>, then Save Changes (Render redeploys).
# This is a TEMPLATE: never write the real API_KEY into this file or commit it.

# Node version used for the build and runtime

# Playwright is only for local UI checks; skip its browser download on Render

# Backend base URL (server.mjs proxies /api/* here)

# SAME value as API_KEY on the backend service (stays on the server, never sent to the browser)
NODE_VERSION=22
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
API_TARGET=https://digital-twin-backend-8tsc.onrender.com

FRAME_ANCESTORS=*

# Site(s) allowed to show this app in an <iframe>: protocol + host only, no path, no trailing slash.
# Several sites: separate with spaces. Leave unset to allow only this app's own origin.

# Do NOT set PORT: Render sets it.
